def fibonacci(n):
    if n == 0:
        return 0
    if n == 1:
        return 1
    return fibonacci(n - 1) + fibonacci(n - 2)


num = int(input("Enter a number: "))

if num < 0:
    print("Fibonacci is not defined for negative numbers")
else:
    print("Fibonacci number at position", num, "is", fibonacci(num))