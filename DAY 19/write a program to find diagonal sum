# Diagonal Sum of Matrix

n = int(input("Enter size of square matrix: "))

matrix = []

print("Enter matrix elements:")
for i in range(n):
    row = list(map(int, input().split()))
    matrix.append(row)

diagonal_sum = 0

for i in range(n):
    diagonal_sum += matrix[i][i]

print("Diagonal Sum =", diagonal_sum)