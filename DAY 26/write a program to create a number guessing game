import random

number = random.randint(1, 100)

print("=== Number Guessing Game ===")
print("Guess a number between 1 and 100")

while True:
    guess = int(input("Enter your guess: "))

    if guess < number:
        print("Too Low!")
    elif guess > number:
        print("Too High!")
    else:
        print("Congratulations! You guessed the correct number.")
        break