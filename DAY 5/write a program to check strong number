def factorial(num):
    fact = 1

    for i in range(1, num + 1):
        fact = fact * i

    return fact


number = int(input("Enter a number: "))

temp = number
sum_of_factorials = 0

while temp > 0:
    digit = temp % 10
    sum_of_factorials = sum_of_factorials + factorial(digit)
    temp = temp // 10

if sum_of_factorials == number:
    print(number, "is a strong number")
else:
    print(number, "is not a strong number")