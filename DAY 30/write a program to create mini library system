books = []

while True:
    print("\n--- Mini Library System ---")
    print("1. Add Book")
    print("2. Display Books")
    print("3. Search Book")
    print("4. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        book = input("Enter Book Name: ")
        author = input("Enter Author Name: ")
        books.append([book, author])
        print("Book Added Successfully!")

    elif choice == "2":
        if len(books) == 0:
            print("No Books Available.")
        else:
            print("\nLibrary Books:")
            for b in books:
                print("Book:", b[0], "| Author:", b[1])

    elif choice == "3":
        name = input("Enter Book Name: ")
        found = False

        for b in books:
            if b[0].lower() == name.lower():
                print("Book Found")
                print("Book:", b[0])
                print("Author:", b[1])
                found = True
                break

        if not found:
            print("Book Not Found.")

    elif choice == "4":
        print("Thank You!")
        break

    else:
        print("Invalid Choice")